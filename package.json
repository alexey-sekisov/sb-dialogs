{
  "name": "sb-dialogs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "types": "dist/sb.d.ts",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build:playground": "vite build --mode playground",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "build:pages": "bun run build && bun run release:prepare && bun run build:playground && bun run prepare:pages",
    "build": "vite build && bun run test:types && bun run build:size",
    "build:size": "node scripts/bundle-size.mjs",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.declaration-test.json",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@bitrix24/b24ui-nuxt": "2.9.0",
    "reka-ui": "2.10.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/language-core": "^3.3.9",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "postcss-prefix-selector": "^2.1.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
