{
  "name": "sb-dialogs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build:playground": "vite build --mode playground",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "build:pages": "bun run build && bun run build:playground && bun run prepare:pages",
    "build": "vite build && bun run build:size",
    "build:size": "node scripts/bundle-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@bitrix24/b24ui-nuxt": "2.9.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "postcss-prefix-selector": "^2.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
